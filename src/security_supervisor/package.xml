<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>security_supervisor</name>
  <version>0.1.0</version>
  <description>Onboard security supervisor: sensor monitoring, trust scoring, anomaly detection, and autonomous response for UAVs.</description>
  <maintainer email="nitinnandakumar5237@gmail.com">nitin-nandakumar</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>px4_msgs</depend>
  <depend>python3-yaml</depend>
  <depend>python3-numpy</depend>
  <depend>python3-sklearn</depend>
  <depend>python3-joblib</depend>
  <depend>python3-cryptography</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
